{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.mjs 4174",
      "startServerReadyPattern": "serving out/",
      "url": [
        "http://localhost:4174/",
        "http://localhost:4174/flights",
        "http://localhost:4174/flights/fd-104",
        "http://localhost:4174/radio"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "blockedUrlPatterns": ["*/hero-worker.js"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 400000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 1200000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
